<!-- LEFT PANEL -->
<div class="left-panel">
  <div class="panel-section">
    <div class="panel-title">Navigation</div>
    <div class="panel-body" style="padding:0;">
      <a href="/" class="panel-item" style="padding:0.35rem 0.85rem;">&#8592; Back to Catalog</a>
    </div>
  </div>
</div>

<!-- MAIN -->
<div class="main-content">
  <div class="page-header">
    <div class="page-title">Add New Book</div>
    <div class="page-sub">Add a new record to the catalog</div>
  </div>
  <div class="form-card">
    <form method="post" action="/add">
      <div class="form-group">
        <label class="form-label">Title *</label>
        <input type="text" name="title" class="form-input" placeholder="Book title" required>
      </div>
      <div class="form-group">
        <label class="form-label">Author *</label>
        <input type="text" name="author" class="form-input" placeholder="Author name" required>
      </div>
      <div class="form-group">
        <label class="form-label">ISBN *</label>
        <input type="text" name="isbn" class="form-input" placeholder="e.g. 9780143039693" required>
      </div>
      <div class="form-group">
        <label class="form-label">Genre</label>
        <input type="text" name="genre" class="form-input" placeholder="e.g. Filipino Literature">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add Book</button>
        <a href="/" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>
