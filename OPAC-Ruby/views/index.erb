<h1>OPAC — Online Public Access Catalog</h1>

<p>Total: <%= @stats[:total] %> | Available: <%= @stats[:available] %> | Borrowed: <%= @stats[:borrowed] %> | Overdue: <%= @stats[:overdue] %></p>

<form method="get" action="/">
  <input type="text" name="search" value="<%= @search %>" placeholder="Search by title, author, or ISBN">
  <button type="submit">Search</button>
  <a href="/">Clear</a>
</form>

<hr>

<table border="1" cellpadding="5">
  <tr>
    <th>ID</th>
    <th>Title</th>
    <th>Author</th>
    <th>ISBN</th>
    <th>Genre</th>
    <th>Status</th>
    <% if admin? %>
      <th>Actions</th>
    <% end %>
  </tr>
  <% @books.each do |book| %>
  <tr>
    <td><%= book.book_id %></td>
    <td><%= book.title %></td>
    <td><%= book.author %></td>
    <td><%= book.isbn %></td>
    <td><%= book.genre %></td>
    <td><%= book.status %></td>
    <% if admin? %>
    <td>
      <a href="/edit/<%= book.book_id %>">Edit</a> |
      <% if book.status == 'available' %>
        <a href="/borrow/<%= book.book_id %>">Borrow</a> |
      <% else %>
        <form method="post" action="/return/<%= book.book_id %>" style="display:inline">
          <button type="submit">Return</button>
        </form> |
      <% end %>
      <form method="post" action="/delete/<%= book.book_id %>" style="display:inline">
        <button type="submit" onclick="return confirm('Delete this book?')">Delete</button>
      </form>
    </td>
    <% end %>
  </tr>
  <% end %>
</table>
